{
  "probe_set": "domain-pool",
  "version": "0.1.0",
  "template": "Describe {keyword}.",
  "note": "COMPREHENSIVE cross-domain pool — deliberately spans the full intellectual/physical/intimate range, not just fields that feel out-of-scope for the current facets. The charged fields (sex_intimacy, death_mortality, religion_ritual, childhood) are the MOST diagnostic: 'desire' through Sexton vs through Foucault are both in-domain-ish and wildly different. SHIPPED STATIC and reused verbatim across facets and runs — determinism is required for the before/after (v0.1.0 vs v0.2.0) cohort comparison to be valid. The pool is NOT pre-graded by difficulty; per-facet, the prober measures each topic's content-distance from the corpus centroid and samples across the gradient (closest -> furthest). A topic that lands near a given facet (e.g. 'inflation' for capital-realist, 'a prime number' for ccru-acolyte, 'the body' for confessional) just becomes one of its low-distance samples — expected, since distance is measured, not assumed. The prober synthesizes per-topic ids as {field}-{slug}. All probes flat-toned: 'Describe {keyword}.'",
  "fields": {
    "physical_science":       ["entropy", "a black hole", "sedimentary rock", "the tide"],
    "life_science":           ["photosynthesis", "a coral reef", "the immune system", "animal migration"],
    "mathematics":            ["a prime number", "infinity", "a proof", "symmetry"],
    "philosophy":             ["consciousness", "free will", "justice", "being"],
    "technology_computers":   ["an algorithm", "the internet", "a robot", "encryption"],
    "engineering":            ["a suspension bridge", "the power grid", "a sewer system", "a dam"],
    "medicine":               ["a heartbeat", "surgery", "a fever", "vaccination"],
    "mind_psychology":        ["memory", "a dream", "anxiety", "perception"],
    "economics":              ["inflation", "a stock market", "a supply chain", "an auction"],
    "law_governance":         ["a trial", "a constitution", "a border", "taxation"],
    "war_military":           ["a battle", "a siege", "surrender", "a soldier"],
    "religion_ritual":        ["prayer", "a pilgrimage", "the sacred", "a funeral"],
    "death_mortality":        ["aging", "a corpse", "mourning", "oblivion"],
    "sex_intimacy":           ["desire", "a kiss", "seduction", "the body"],
    "childhood":              ["a playground", "a tantrum", "growing up", "a lullaby"],
    "language_translation":   ["a dialect", "translation", "grammar", "a pun"],
    "literature":             ["a novel", "metaphor", "a library", "a sonnet"],
    "art_music":              ["a fugue", "a fresco", "a drum", "choreography"],
    "sport_games":            ["a marathon", "chess", "figure skating", "a penalty kick"],
    "food_cuisine":           ["fermentation", "bread", "a banquet", "a kitchen knife"],
    "craft_trade":            ["welding", "masonry", "weaving", "plumbing"],
    "fashion":                ["a dress", "a runway", "tailoring", "a uniform"],
    "gambling":               ["a dice roll", "a casino", "odds", "a bet"],
    "nature_ecology":         ["a forest fire", "a desert", "a river delta", "a glacier"],
    "domestic_everyday":      ["laundry", "a grocery store", "a commute", "a thermostat"],
    "transit_infrastructure": ["a subway", "a shipping port", "an airport", "a highway"],
    "astronomy_space":        ["a comet", "the moon", "a rocket launch", "a constellation"]
  }
}
